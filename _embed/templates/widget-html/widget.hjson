{
	widgetId:"html"
	label:"HTML Code"
	description:"Embed HTML code"
	schema:{
		type:"object"
		properties:{
			html:{
				type:"string"
				format:"unsafe-any"
				maxLength:100000
			}
		}
	}
	form:{
		type:"layout-vertical"
		label:"Edit HTML Content"
		children: [
			{type:"textarea", description:"HTML code will be embedded directly into this stream", path:"html", options:{rows:10}}
		]
	}
}