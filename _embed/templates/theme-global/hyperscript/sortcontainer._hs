-- loadSortable adds Sortable.js to the page once, and fires sortableReady on window when it arrives.
-- RULE: a template's own <script src> re-runs Sortable on every swap, so lists load it here (see AGENTS.md).
js
	function loadSortable() {

		if (window.Sortable) {
			return;
		}

		if (document.getElementById("sortable-library")) {
			return;
		}

		var script = document.createElement("script");
		script.id = "sortable-library";
		script.src = "/.themes/global/resources/sortable-1.15.7/Sortable.min.js";
		script.onload = function() {
			window.dispatchEvent(new Event("sortableReady"));
		};
		document.head.appendChild(script);
	}
end

behavior sortContainer

	init
		call loadSortable()
	end

	-- RULE: install on load or on sortableReady, whichever comes second; the guard makes the other a no-op
	on load or sortableReady from window

		if Sortable is null then
			exit
		end

		if :sortableInstalled is true then
			exit
		end

		set :sortableInstalled to true

		-- data-sortable-handle and data-sortable-draggable pass options on; one left out keeps Sortable's default
		set options to {animation:150, ghostClass:'draggable-whisper'}
		if @data-sortable-handle exists then set options.handle to @data-sortable-handle end
		if @data-sortable-draggable exists then set options.draggable to @data-sortable-draggable end
		make a Sortable from me, options
	end
end
