behavior select(value, options, prefix)

	init

		if options is not null then
			for option in options

				if prefix is not null then 
					set option.value to prefix + option.value
				end
				
				-- The label and value are data, so build a node rather than parsing them as HTML
				make an Option from option.label, option.value called optionElement
				call me.add(optionElement)
			end
		end

		if value is not ""
			set selectedOption to first <option[value="${value}"]/> in me

			if selectedOption is not null
				set selectedOption.selected to true
			end
		end
	end
end