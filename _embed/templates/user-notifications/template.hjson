{
	templateId: user-notifications
	templateRole: user-notifications
	category: Special
	model: Notifications
	label: Default Notifications
	description: A simple notifications section that informs users when they have new social activity
	icon: bell
	extends: ["base-social"]
	containedBy: []
	schema: {
		title: User Notifications
		type: object
		properties: {}
	}
	states: {
		default: {
			label: Notifications only has default state
		}
	}
	roles: {}
	bundles: {
		stylesheet: {
			content-type: text/css
		}
	}
	actions: {

		// Bare /@me/notifications lands on the "Messages & Replies" section.  Render the
		// replies page directly (same steps as the `replies` action) rather than redirecting,
		// so the bare URL serves content in one request.
		index: {
			roles: ["self"]
			steps:[
				{do:"set-query-param", type:"MENTION"}
				{do:"view-html", file:"replies"}
			]
		}

		// The six tab pages. Each sets its ?type= so the sidebar, header and list read the same tab,
		// and each has a -list action for lazy loading and infinite scroll.
		all: {
			roles:["self"]
			steps:[
				{do:"set-query-param", type:"ALL"}
				{do:"view-html"}
			]
		}

		all-list: {
			roles:["self"]
			steps:[
				{do:"set-query-param", type:"ALL"}
				{do:"set-header", name:"Cache-Control", value:"no-store"}
				{do:"view-html"}
			]
		}

		replies: {
			roles:["self"]
			steps:[
				{do:"set-query-param", type:"MENTION"}
				{do:"view-html"}
			]
		}

		replies-list: {
			roles:["self"]
			steps:[
				{do:"set-query-param", type:"MENTION"}
				{do:"set-header", name:"Cache-Control", value:"no-store"}
				{do:"view-html"}
			]
		}

		quotes: {
			roles:["self"]
			steps:[
				{do:"set-query-param", type:"QUOTE"}
				{do:"view-html"}
			]
		}

		quotes-list: {
			roles:["self"]
			steps:[
				{do:"set-query-param", type:"QUOTE"}
				{do:"set-header", name:"Cache-Control", value:"no-store"}
				{do:"view-html"}
			]
		}

		// The modal for one quote (?notificationId=), which shows the quoting post and offers Reject
		quote: {
			roles:["self"]
			steps:[
				{do:"set-header", name:"Cache-Control", value:"no-store"}
				{do:"as-modal", steps:[
					{do:"view-html"}
				]}
			]
		}

		shares: {
			roles:["self"]
			steps:[
				{do:"set-query-param", type:"ANNOUNCE"}
				{do:"view-html"}
			]
		}

		shares-list: {
			roles:["self"]
			steps:[
				{do:"set-query-param", type:"ANNOUNCE"}
				{do:"set-header", name:"Cache-Control", value:"no-store"}
				{do:"view-html"}
			]
		}

		likes: {
			roles:["self"]
			steps:[
				{do:"set-query-param", type:"LIKE"}
				{do:"view-html"}
			]
		}

		likes-list: {
			roles:["self"]
			steps:[
				{do:"set-query-param", type:"LIKE"}
				{do:"set-header", name:"Cache-Control", value:"no-store"}
				{do:"view-html"}
			]
		}

		followers: {
			roles:["self"]
			steps:[
				{do:"set-query-param", type:"FOLLOW"}
				{do:"view-html"}
			]
		}

		followers-list: {
			roles:["self"]
			steps:[
				{do:"set-query-param", type:"FOLLOW"}
				{do:"set-header", name:"Cache-Control", value:"no-store"}
				{do:"view-html"}
			]
		}

		badge: {
			roles:["self"]
			steps:[
				{do:"set-header", name:"Cache-Control", value:"no-store"}
				{do:"view-html"}
			]
		}

		// Marks notifications as read, scoped to one tab via ?type= (ALL, or no type, = all types).
		// Posted by the "Mark All Read" button.  refreshSidebar updates the nav badge, the
		// sidebar dot, and the tab counts; refreshPage re-renders the list so the per-row
		// unread dots clear too.
		read: {
			roles:["self"]
			steps:[
				{do:"mark-notifications-read"}
				{do:"trigger-event", event:"refreshSidebar"}
				{do:"trigger-event", event:"refreshPage"}
			]
		}

		// Marks one notification (?notificationId=) read, when its row is clicked. It does not fire
		// refreshPage, which would redraw the list under the modal that the click is opening.
		read-one: {
			roles:["self"]
			steps:[
				{do:"mark-notifications-read"}
				{do:"trigger-event", event:"refreshSidebar"}
			]
		}

		// Rejects one quote of the User's posts, by deleting the CollectionItem (?collectionItemId=) that approves it
		reject-quote: {
			roles:["self"]
			steps:[
				{do:"with-collection-item", type:"Quotes", steps:[
					{do:"delete", method:"post"}
				]}
				{do:"trigger-event", event:"refreshSidebar"}
				{do:"trigger-event", event:"refreshPage"}
			]
		}

		// Header fragment (title / mobile tabs, "Mark All Read", with unread counts),
		// re-fetched on refreshSidebar.
		header: {
			roles:["self"]
			steps:[
				{do:"set-header", name:"Cache-Control", value:"no-store"}
				{do:"view-html"}
			]
		}

		// Standalone Notifications sidebar fragment, re-fetched on refreshSidebar
		// (?type= keeps the selected filter and its counts current).
		sidebar: {
			roles:["self"]
			steps:[
				{do:"set-header", name:"Cache-Control", value:"no-store"}
				{do:"view-html"}
			]
		}
	}
}	
