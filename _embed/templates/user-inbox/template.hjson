{
	templateId: user-inbox
	templateRole: user-inbox
	category: Special
	model: Inbox
	label: Default Inbox
	description: A simple inbox with a sidebar for folders and several feed layouts
	icon: inbox
	extends: ["base-social"]
	containedBy: []
	schema: {
		title: User Profile
		type: object
		properties: {
			feeds: {
				description: Array of people to render on the page
				type: array
				items: {
					type: object
					properties: {
						url: {
							type: string
						}
						name: {
							type: string
						}
					}
				}
			}
		}
	}
	states: {
		default: {
			label: Inbox only has default state
		}
	}
	roles: {}
	bundles: {
		stylesheet: {
			content-type: text/css
		}
		hyperscript: {
			content-type: text/hyperscript
		}
	}
	actions: {

		// The private annotation editor for ?url=; an empty note keeps the annotation
		annotation: {
			roles: ["self"]
			steps: [
				{do: "with-annotation", steps: [

					// Actor notes use the standard modal, document notes the large one; actor links pass ?type=ACTOR
					{do: "as-modal", options:["class:{{iif .Object.IsActor `medium` `large`}}"], steps: [
						{do: "view-html"}
						{
							do:"edit", 
							options:[
								"submit-label:{{iif .IsNew `Add a Note` `Update Note`}}",
								"delete:/@me/newsfeed/annotation-delete?annotationId={{.ObjectID}}", 
								"delete-label:Delete", 
							], 
							form: {
								type: layout-vertical
								children:[
									{type:"textarea", path:"content", description:"(PRIVATE) These notes are not shared with anyone", options:{rows:12, autocomplete:"off"}}
								]
							}
						}
						{do: "save"}
						{do: "trigger-event", event:"annotationChanged", value:"{{.Object.URL}}"}
					]}
				]}
			]
		}

		// RULE: remove-event must share a pipeline with delete (see AGENTS.md)
		annotation-delete: {
			roles: ["self"]
			steps: [
				{do: "with-annotation", steps: [
					{do: "if", condition:"{{.Object.IsDocument}}", then:[
						{do: "delete", title:"Delete these Notes?", message:"Your private notes on this will be deleted.", submit:"Delete"}
						{do: "trigger-event", event:"annotationChanged", value:"{{.Object.URL}}"}
						{do: "remove-event", event:"closeModal"}
					], else:[
						{do: "delete", title:"Delete these Notes?", message:"Your private notes on this will be deleted.", submit:"Delete"}
						{do: "trigger-event", event:"annotationChanged", value:"{{.Object.URL}}"}
					]}
				]}
				// RULE: only a document note's Delete link carries ?url=, and only it redraws the browse modal (see AGENTS.md)
				{do: "if", condition:"{{ne `` (.QueryParam `url`)}}", then:[
					{do: "view-html", method:"post", file:"browse-annotation-modal"}
				]}
			]
		}

		annotation-button: {
			roles: ["self"]
			steps: [
				{do:"set-header", name:"Cache-Control", value:"no-store"}
				{do:"view-html"}
			]
		}

		// The Notes page, with the sidebar's Notes item selected; ?type=actor|document narrows the list
		annotations: {
			roles: ["self"]
			steps: [
				{do:"set-query-param", section:"ANNOTATIONS"}
				{do:"view-html"}
			]
		}

		annotations-list: {
			roles: ["self"]
			steps: [
				{do:"set-header", name:"Cache-Control", value:"no-store"}
				{do:"view-html"}
			]
		}

		browse: {
			roles: ["self"]
			steps: [
				{do:"as-modal", options:["class:large"], background:"inbox", steps:[
					{do:"set-header", name:"Cache-Control", value:"no-store"}
					{do: "view-html"}
				]}
			]
		}

		browse-actor: {
			roles: ["self"]
			steps: [
				{do:"as-modal", options:["class:medium"], background:"inbox", steps:[
					{do:"set-header", name:"Cache-Control", value:"no-store"}
					{do: "view-html"}
				]}
			]
		}

		browse-actor-featured: {
			roles: ["self"]
			steps: [
				{do:"set-header", name:"Cache-Control", value:"no-store"}
				{do: "view-html"}
			]
		}

		browse-code: {
			roles: ["self"]
			steps: [
				{do:"set-header", name:"Cache-Control", value:"no-store"}
				{do:"view-html"}
			]
		}

		browse-index: {
			roles: ["self"]
			steps: [
				{do:"set-header", name:"Cache-Control", value:"no-store"}
				{do:"view-html"}
			]
		}

		// The Notes view of the browse modal; its editor is the annotation-editor action
		browse-annotation: {
			roles: ["self"]
			steps: [
				{do:"as-modal", options:["class:large"], steps:[
					{do:"set-header", name:"Cache-Control", value:"no-store"}
					{do:"view-html"}
				]}
			]
		}

		browse-reply: {
			roles: ["self"]
			steps: [
				{do:"as-modal", options:["class:large"], steps:[
					{do:"view-html"}
				]}
			]
		}

		browse-tree: {
			roles: ["self"]
			steps: [
				{do:"view-html"}
			]
		}

		browse-tree-replies: {
			roles: ["self"]
			steps: [
				{do:"view-html"}
			]
		}

		browse-tree-reply: {
			roles: ["self"]
			steps: [
				{do:"view-html"}
			]
		}


		// News Feed: the zero folderId selects the "all folders" entry
		feed: {
			roles: ["self"]
			steps:[
				{do:"set-query-param", folderId:"000000000000000000000000"}
				{do:"view-html", file:"index"}
			]
		}

		filter: {
			roles: ["self"]
			steps: [
				{do: "as-modal", steps: [
					{do: "view-html"}
				]}
			]
		}

		folder-add: {
			roles: ["self"]
			steps: [
				{do: "set-query-param", folderId: "new"}
				{do: "with-folder", steps: [
					{do: "as-modal", steps: [
						{do: "edit", form: {
							type: layout-vertical
							label: New Folder
							children: [
								{type: "text", path: "label", label: "Name", options:{autocomplete:"off", validator:"/.validate/folder/name?folderId={{.ID}}"}}
								{type: "select-icons", path: "icon", label: "Icon", options: {provider: "navigation-icons"}}
								{type: "select", path: "layout", label: "Layout", options: {enum: "SOCIAL,NEWSPAPER,MAGAZINE"}}
							]}
						}
						{do: "save"}
					]}
					{do: "refresh-page"}
				]}
			]
		}

		folder-edit: {
			roles: ["self"]
			steps: [
				{do: "with-folder", steps: [
					{do: "as-modal", steps: [
						{do:"edit", options:["delete:/@me/newsfeed/folder-delete?folderId={{.ObjectID}}"], form:{
							type: layout-vertical
							label: Folder Settings
							children:[
								{type:"text", path:"label", label:"Name", options:{autocomplete:"off", validator:"/.validate/folder/name?folderId={{.ID}}"}}
								{type:"select-icons", path:"icon", label:"Icon", options:{provider:"navigation-icons"}}
								{type:"select", path:"layout", label:"Layout", options:{enum:"SOCIAL,NEWSPAPER,MAGAZINE"}}
							]}
						}
						{do:"save"}
					]}
					{do:"refresh-page"}
				]}
			]
		}

		folder-delete:{
			roles:["self"]
			steps:[
				{do:"with-folder", steps: [
					{do:"delete", title:"Delete Folder: {{.Label}}?", message:"Deleting this folder will also remove all inbox items inside it."}
					{do:"forward-to", url:"/@me/newsfeed/feed"}
				]}
			]
		}
		
		// Marks every message in ?folderId= as read; index.html posts it on load
		folder-read:{
			roles:["self"]
			steps:[
				{do:"mark-folder-read"}
				{do:"trigger-event", event:"refreshSidebar"}
			]
		}

		folder-sort:{
			roles:["self"]
			steps:[
				{do:"with-folder", steps:[
					{do:"sort"}
				]}
			]
		}
		
		// Shows the folder named by ?folderId=, or the News Feed without one
		folder: {
			roles: ["self"]
			steps:[
				{do: "view-html", file: "index"}
			]
		}

		index: {
			roles: ["self"]
			steps:[
				// Redirects to the News Feed, or to /folder when ?folderId= is set
				{do:"if", condition:"{{eq `` (.QueryParam `folderId`)}}", then:[
					{do:"redirect-to", url:"/@me/newsfeed/feed"}
				], else:[
					{do:"redirect-to", url:"/@me/newsfeed/folder?folderId={{.QueryParam `folderId`}}"}
				]}
			]
		}

		list: {
			roles: ["self"]
			steps: [
				{do:"set-header", name:"Cache-Control", value:"no-store"}
				{do: "view-html"}
			]
		}

		list-before: {
			roles: ["self"]
			steps:[
				{do:"set-header", name:"Cache-Control", value:"no-store"}
				{do: "view-html"}
			]
		}

		message-read:{
			roles:["self"]
			steps:[
				{do:"with-message", steps:[
					{do:"set-state", state:"READ"}
					{do:"save"}
					{do:"trigger-event", event:"refreshSidebar"}
				]}
			]
		}

		mobile: {
			roles:["self"]
			steps:[
				{do:"view-html"}
			]
		}

		// Redirects old notifications URLs (?type=) to the user-notifications pages
		notifications: {
			roles:["self"]
			steps:[
				{do:"if", condition:"{{eq `ANNOUNCE` (.QueryParam `type`)}}", then:[
					{do:"redirect-to", url:"/@me/notifications/shares"}
				], else:[
					{do:"if", condition:"{{eq `LIKE` (.QueryParam `type`)}}", then:[
						{do:"redirect-to", url:"/@me/notifications/likes"}
					], else:[
						{do:"if", condition:"{{eq `FOLLOW` (.QueryParam `type`)}}", then:[
							{do:"redirect-to", url:"/@me/notifications/followers"}
						], else:[
							{do:"redirect-to", url:"/@me/notifications/replies"}
						]}
					]}
				]}
			]
		}

		// RULE: the note form posts to itself, not the modal, then redraws the modal (see AGENTS.md)
		annotation-editor: {
			roles: ["self"]
			steps: [
				{do: "set-query-param", type:"DOCUMENT"}
				{do: "with-annotation", steps: [
					{do:"edit", options:["endpoint:/@me/newsfeed/annotation-editor?url={{.QueryParam `url` | urlquery}}", "delete:/@me/newsfeed/annotation-delete?annotationId={{.ObjectID}}&url={{.QueryParam `url` | urlquery}}", "delete-label:Delete", "submit-label:{{if .IsNew}}Add a Note{{else}}Update Note{{end}}"], form: {
						type: layout-vertical
						children:[
							{type:"textarea", path:"content", options:{rows:6, autocomplete:"off", focus:true}}
						]
					}}
					{do: "save"}
					{do: "trigger-event", event:"annotationChanged", value:"{{.Object.URL}}"}
				]}
				// RULE: the Inbox redraws the modal, never the Annotation's builder (see AGENTS.md)
				{do: "view-html", method:"post", file:"browse-annotation-modal"}
			]
		}

		reply:{
			roles:["self"]
			steps:[
				{do:"set-args", postTo:"/@me/newsfeed/reply?url={{.Permalink}}"}
				{do:"add-stream", 
					style:"inline", 
					roles:"outbox-reply", 
					location:"outbox", 
					with-data:{
						inReplyTo:"{{.Permalink}}"
					},
					redirect-to:"/@me/newsfeed/browse-tree?url={{.Permalink}}"
				}
			]
		}

		// News Feed sidebar fragment, re-fetched on refreshSidebar; ?folderId= keeps the selection
		newsfeed-sidebar: {
			roles: ["self"]
			steps:[
				{do:"set-header", name:"Cache-Control", value:"no-store"}
				{do:"view-html"}
			]
		}
	}
}	
