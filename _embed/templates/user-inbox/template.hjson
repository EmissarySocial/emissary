{
	templateId: user-inbox
	templateRole: user-inbox
	category: Special
	model: Inbox
	label: Default Inbox
	description: A simple inbox with a sidebar for folders and several feed layouts
	icon: inbox
	extends: ["base-social"]
	containedBy: []
	schema: {
		title: User Profile
		type: object
		properties: {
			feeds: {
				description: Array of people to render on the page
				type: array
				items: {
					type: object
					properties: {
						url: {
							type: string
						}
						name: {
							type: string
						}
					}
				}
			}
		}
	}
	states: {
		default: {
			label: Inbox only has default state
		}
	}
	roles: {}
	bundles: {
		stylesheet: {
			content-type: text/css
		}
		hyperscript: {
			content-type: text/hyperscript
		}
	}
	actions: {

		actor-button: {
			roles:["self"]
			steps: [
				{do:"set-header", name:"Cache-Control", value:"no-store"}
				{do:"set-header", name:"Hx-Reswap", value:"outerHTML"}
				{do:"set-header", name:"Hx-Push-Url", value:"false"}
				{do:"view-html"}
			]
		}

		actor-button-follow: {
			roles:["self"]
			steps:[
				{do:"with-following", steps:[
					{do:"set-data", from-url:["folderId", "url"], values: {behavior:"POSTS+REPLIES"}}
					{do:"save"}
					{do:"trigger-event", event:"refreshPeers"}
					{do:"view-html", method:"post", file:"actor-button-follow"}
				]}
			]
		}

		actor-button-follow-update: {
			roles:["self"]
			steps:[
				{do:"with-following", steps:[
					{do:"set-data", from-form:["behavior", "isPublic"]}
					{do:"save"}
					{do:"trigger-event", event:"refreshPeers"}
					{do:"inline-success", message:"Saved"}
				]}
			]
		}

		actor-button-unfollow: {
			roles:["self"]
			steps:[
				{do:"with-following", steps:[
					{do:"delete"}
				]}
				{do:"view-html", method:"post", file:"actor-button-none"}
				{do:"trigger-event", event:"refreshPeers"}
				{do:"remove-event", event:"closeModal"}
			]
		}

		actor-button-mute:{
			roles:["self"]
			steps:[
				{do:"with-rule", steps:[
					{do:"set-data", values: {type:"ACTOR", action: "MUTE", trigger:"{{.QueryParam `url`}}"}}
					{do:"save"}
					{do:"trigger-event", event:"refreshPeers"}
					{do:"view-html", method:"post", file:"actor-button-mute"}
				]}
			]
		}

		actor-button-unmute:{
			roles:["self"]
			steps:[
				{do:"with-rule", steps:[
					{do:"delete"}
				]}
				{do:"view-html", method:"post", file:"actor-button-none"}
				{do:"trigger-event", event:"refreshPeers"}
				{do:"remove-event", event:"closeModal"}
			]
		}

		actor-button-block:{
			roles:["self"]
			steps:[
				{do:"with-rule", steps:[
					{do:"set-data", values: {type:"ACTOR", action: "BLOCK", trigger: "{{.QueryParam `url`}}"}}
					{do:"save"}
					{do:"trigger-event", event:"refreshPeers"}
					{do:"view-html", method:"post", file:"actor-button-block"}
				]}
			]
		}

		actor-button-block-update: {
			roles:["self"]
			steps:[
				{do:"with-rule", steps:[
					{do:"set-data", from-form:["summary"]}
					{do:"save"}
					{do:"trigger-event", event:"refreshPeers"}
					{do:"inline-success", message:"Saved"}
				]}
			]
		}

		actor-button-unblock:{
			roles:["self"]
			steps:[
				{do:"with-rule", steps:[
					{do:"delete"}
				]}
				{do:"trigger-event", event:"refreshPeers"}
				{do:"remove-event", event:"closeModal"}
				{do:"view-html", method:"post", file:"actor-button-none"}
			]
		}

		// The private annotation editor for ?url=.  Saving with an empty note keeps the
		// annotation; only annotation-delete removes it.
		annotation: {
			roles: ["self"]
			steps: [
				{do: "with-annotation", steps: [

					// An actor's notes are a tab of the standard-size actor modal; a document's use the
					// large modal of the document browser.  Actor links pass ?type=ACTOR for a new record.
					{do: "as-modal", options:["class:{{iif .Object.IsActor `` `large`}}"], steps: [
						{do: "view-html"}
						{do:"edit", options:["delete:/@me/newsfeed/annotation-delete?annotationId={{.ObjectID}}", "delete-label:Delete", "submit-label:{{if .IsNew}}Add a Note{{else}}Update Note{{end}}"], form: {
							type: layout-vertical
							children:[
								{type:"textarea", path:"content", description:"(PRIVATE) These notes are not shared with anyone", options:{rows:12, autocomplete:"off"}}
							]
						}}
						{do: "save"}
						{do: "trigger-event", event:"annotationChanged", value:"{{.Object.URL}}"}
					]}
				]}
			]
		}

		// A document's notes redraw the browse modal after the delete, so its Notes tab updates;
		// an actor's notes close the modal.  remove-event must share a pipeline with delete.
		annotation-delete: {
			roles: ["self"]
			steps: [
				{do: "with-annotation", steps: [
					{do: "if", condition:"{{.Object.IsDocument}}", then:[
						{do: "delete", title:"Delete these Notes?", message:"Your private notes on this will be deleted.", submit:"Delete"}
						{do: "trigger-event", event:"annotationChanged", value:"{{.Object.URL}}"}
						{do: "remove-event", event:"closeModal"}
						{do: "view-html", method:"post", file:"browse-annotation-modal"}
					], else:[
						{do: "delete", title:"Delete these Notes?", message:"Your private notes on this will be deleted.", submit:"Delete"}
						{do: "trigger-event", event:"annotationChanged", value:"{{.Object.URL}}"}
					]}
				]}
			]
		}

		annotation-button: {
			roles: ["self"]
			steps: [
				{do:"set-header", name:"Cache-Control", value:"no-store"}
				{do:"view-html"}
			]
		}

		// The Notes page: renders in the same frame as the folders, with the sidebar's
		// Notes item selected.  ?type=actor|document narrows the list.
		annotations: {
			roles: ["self"]
			steps: [
				{do:"set-query-param", section:"ANNOTATIONS"}
				{do:"view-html"}
			]
		}

		annotations-list: {
			roles: ["self"]
			steps: [
				{do:"set-header", name:"Cache-Control", value:"no-store"}
				{do:"view-html"}
			]
		}

		browse: {
			roles: ["self"]
			steps: [
				{do:"as-modal", options:["class:large"], background:"inbox", steps:[
					{do:"set-header", name:"Cache-Control", value:"no-store"}
					{do: "view-html"}
				]}
			]
		}

		browse-actor: {
			roles: ["self"]
			steps: [
				{do:"as-modal", background:"inbox", steps:[
					{do:"set-header", name:"Cache-Control", value:"no-store"}
					{do: "view-html"}
				]}
			]
		}

		browse-actor-featured: {
			roles: ["self"]
			steps: [
				{do:"set-header", name:"Cache-Control", value:"no-store"}
				{do: "view-html"}
			]
		}

		browse-code: {
			roles: ["self"]
			steps: [
				{do:"set-header", name:"Cache-Control", value:"no-store"}
				{do:"view-html"}
			]
		}

		browse-document-detail: {
			roles: ["self"]
			steps: [
				{do:"set-header", name:"Cache-Control", value:"no-store"}
				{do:"view-html"}
			]
		}

		browse-index: {
			roles: ["self"]
			steps: [
				{do:"set-header", name:"Cache-Control", value:"no-store"}
				{do:"view-html"}
			]
		}

		// The Notes view of the browse modal, opened by every annotation button and by the Notes tab.
		// The editor below the thread is the annotation-editor action.
		browse-annotation: {
			roles: ["self"]
			steps: [
				{do:"as-modal", options:["class:large"], steps:[
					{do:"set-header", name:"Cache-Control", value:"no-store"}
					{do:"view-html"}
				]}
			]
		}

		browse-reply: {
			roles: ["self"]
			steps: [
				{do:"as-modal", options:["class:large"], steps:[
					{do:"view-html"}
				]}
			]
		}

		browse-timeline: {
			roles: ["self"]
			steps: [
				{do:"view-html"}
			]
		}

		browse-timeline-list: {
			roles: ["self"]
			steps: [
				{do:"view-html"}
			]
		}

		browse-tree: {
			roles: ["self"]
			steps: [
				{do:"view-html"}
			]
		}

		browse-tree-replies: {
			roles: ["self"]
			steps: [
				{do:"view-html"}
			]
		}

		browse-tree-reply: {
			roles: ["self"]
			steps: [
				{do:"view-html"}
			]
		}


		// Explicit News Feed (all folders) view.  The zero folderId selects the synthetic
		// "all folders" entry; without it, the folder view defaults to the first folder.
		feed: {
			roles: ["self"]
			steps:[
				{do:"set-query-param", folderId:"000000000000000000000000"}
				{do:"view-html", file:"index"}
			]
		}

		filter: {
			roles: ["self"]
			steps: [
				{do: "as-modal", steps: [
					{do: "view-html"}
				]}
			]
		}

		folder-add: {
			roles: ["self"]
			steps: [
				{do: "set-query-param", folderId: "new"}
				{do: "with-folder", steps: [
					{do: "as-modal", steps: [
						{do: "edit", form: {
							type: layout-vertical
							label: Add a Folder
							children: [
								{type: "text", path: "label", label: "Name", options:{autocomplete:"off", validator:"/.validate/folder/name?folderId={{.ID}}"}}
								{type: "select-icons", path: "icon", label: "Icon", options: {provider: "navigation-icons"}}
								{type: "select", path: "layout", label: "Layout", options: {enum: "SOCIAL,NEWSPAPER,MAGAZINE"}}
							]}
						}
						{do: "save"}
					]}
					{do: "refresh-page"}
				]}
			]
		}

		folder-edit: {
			roles: ["self"]
			steps: [
				{do: "with-folder", steps: [
					{do: "as-modal", steps: [
						{do:"edit", options:["delete:/@me/newsfeed/folder-delete?folderId={{.ObjectID}}"], form:{
							type: layout-vertical
							label: Folder Settings
							children:[
								{type:"text", path:"label", label:"Name", options:{autocomplete:"off", validator:"/.validate/folder/name?folderId={{.ID}}"}}
								{type:"select-icons", path:"icon", label:"Icon", options:{provider:"navigation-icons"}}
								{type:"select", path:"layout", label:"Layout", options:{enum:"SOCIAL,NEWSPAPER,MAGAZINE"}}
							]}
						}
						{do:"save"}
					]}
					{do:"refresh-page"}
				]}
			]
		}

		folder-delete:{
			roles:["self"]
			steps:[
				{do:"with-folder", steps: [
					{do:"delete", title:"Delete Folder: {{.Label}}?", message:"Deleting this folder will also remove all inbox items inside it."}
					{do:"forward-to", url:"/@me/newsfeed/feed"}
				]}
			]
		}
		
		// Marks every unread message in the folder (from ?folderId=) as read.  Posted by
		// the folder view on load (Mastodon-style), clearing the folder's unread dot.
		folder-read:{
			roles:["self"]
			steps:[
				{do:"mark-folder-read"}
				{do:"trigger-event", event:"refreshSidebar"}
			]
		}

		folder-sort:{
			roles:["self"]
			steps:[
				{do:"with-folder", steps:[
					{do:"sort"}
				]}
			]
		}
		
		// Explicit folder view: /@me/newsfeed/folder shows the News Feed (all folders);
		// /@me/newsfeed/folder?folderId=xxx shows one folder.  Renders index.html.
		folder: {
			roles: ["self"]
			steps:[
				{do: "view-html", file: "index"}
			]
		}

		index: {
			roles: ["self"]
			steps:[
				// Bare /@me/newsfeed lands on the News Feed (all folders); Notifications is
				// its own top-level nav section now.  Legacy ?folderId= URLs redirect to the
				// explicit /folder route.
				{do:"if", condition:"{{eq `` (.QueryParam `folderId`)}}", then:[
					{do:"redirect-to", url:"/@me/newsfeed/feed"}
				], otherwise:[
					{do:"redirect-to", url:"/@me/newsfeed/folder?folderId={{.QueryParam `folderId`}}"}
				]}
			]
		}

		list: {
			roles: ["self"]
			steps: [
				{do:"set-header", name:"Cache-Control", value:"no-store"}
				{do: "view-html"}
			]
		}

		list-before: {
			roles: ["self"]
			steps:[
				{do:"set-header", name:"Cache-Control", value:"no-store"}
				{do: "view-html"}
			]
		}

		message: {
			roles:["self"]
			steps:[
				{do:"as-modal", options:["xclass:large"], steps:[
					{do:"set-header", name:"Cache-Control", value:"no-store"}
					{do:"view-html"}
				]}
			]
		}

		message-code: {
			roles:["self"]
			steps:[
				{do:"as-modal", options:["class:large"], steps:[
					{do:"view-html"}
				]}
			]
		}

		message-mute-button:{
			roles:["self"]
			steps:[
				{do:"with-message", steps:[
					{do:"view-html"}
				]}
			]
		}

		message-mute:{
			roles:["self"]
			steps:[
				{do:"with-message", steps:[
					{do:"set-state", state:"MUTED"}
					{do:"save"}
					{do:"view-html", method:"both", file:"message-mute-button"}
				]}
			]
		}

		message-unmute:{
			roles:["self"]
			steps:[
				{do:"with-message", steps:[
					{do:"set-state", state:"UNMUTED"}
					{do:"save"}
					{do:"view-html", method:"both", file:"message-mute-button"}
				]}
			]
		}

		message-delete: {
			roles: ["self"]
			steps: [
				{do:"with-message", steps:[
					{do:"delete", title:"Delete Message?", message:"Are you sure you want to delete this message?"}
					{do:"reload-page"}
				]}
			]
		}

		message-read:{
			roles:["self"]
			steps:[
				{do:"with-message", steps:[
					{do:"set-state", state:"READ"}
					{do:"save"}
					{do:"trigger-event", event:"refreshSidebar"}
				]}
			]
		}

		message-set-response: {
			roles:["self"]
			steps:[
				{do:"with-message", steps: [
					{do:"set-response"}
					{do:"view-html", method:"both"}
				]}
			]
		}

		mobile: {
			roles:["self"]
			steps:[
				{do:"view-html"}
			]
		}

		// LEGACY entry point.  Notifications live in their own template/route now
		// (/@me/notifications — see the user-notifications template); redirect old
		// /@me/notifications(?type=xxx) URLs to the matching section page.
		notifications: {
			roles:["self"]
			steps:[
				{do:"if", condition:"{{eq `ANNOUNCE` (.QueryParam `type`)}}", then:[
					{do:"redirect-to", url:"/@me/notifications/shares"}
				], otherwise:[
					{do:"if", condition:"{{eq `LIKE` (.QueryParam `type`)}}", then:[
						{do:"redirect-to", url:"/@me/notifications/likes"}
					], otherwise:[
						{do:"if", condition:"{{eq `FOLLOW` (.QueryParam `type`)}}", then:[
							{do:"redirect-to", url:"/@me/notifications/followers"}
						], otherwise:[
							{do:"redirect-to", url:"/@me/notifications/replies"}
						]}
					]}
				]}
			]
		}

		responses-likes:{
			roles:["self"]
			steps: [
				{do:"view-html"}
			]
		}

		responses-replies:{
			roles:["self"]
			steps: [
				{do:"view-html"}
			]
		}

		responses-replies-list:{
			roles:["self"]
			steps:[
				{do:"view-html"}
			]
		}

		responses-replies-recursive:{
			roles:["self"]
			steps:[
				{do:"view-html"}
			]
		}

		// The private note form for ?url=, rendered under the thread by browse-annotation.  It posts
		// to itself, not to the modal, then redraws the whole modal so the Notes tab updates.  An
		// empty note still keeps the annotation; only Delete removes it.
		annotation-editor: {
			roles: ["self"]
			steps: [
				{do: "set-query-param", type:"DOCUMENT"}
				{do: "with-annotation", steps: [
					{do:"edit", options:["endpoint:/@me/newsfeed/annotation-editor?url={{.QueryParam `url` | urlquery}}", "delete:/@me/newsfeed/annotation-delete?annotationId={{.ObjectID}}&url={{.QueryParam `url` | urlquery}}", "delete-label:Delete", "submit-label:{{if .IsNew}}Add a Note{{else}}Update Note{{end}}"], form: {
						type: layout-vertical
						children:[
							{type:"textarea", path:"content", options:{rows:6, autocomplete:"off", focus:true}}
						]
					}}
					{do: "save"}
					{do: "trigger-event", event:"annotationChanged", value:"{{.Object.URL}}"}
					{do: "view-html", method:"post", file:"browse-annotation-modal"}
				]}
			]
		}

		reply:{
			roles:["self"]
			steps:[
				{do:"set-args", postTo:"/@me/newsfeed/reply?url={{.Permalink}}"}
				{do:"add-stream", 
					style:"inline", 
					roles:"outbox-reply", 
					location:"outbox", 
					with-data:{
						inReplyTo:"{{.Permalink}}"
					},
					redirect-to:"/@me/newsfeed/browse-tree?url={{.Permalink}}"
				}
			]
		}

		// Standalone News Feed sidebar fragment, re-fetched on refreshSidebar
		// (?folderId= keeps the selected folder).
		newsfeed-sidebar: {
			roles: ["self"]
			steps:[
				{do:"set-header", name:"Cache-Control", value:"no-store"}
				{do:"view-html"}
			]
		}
	}
}	
