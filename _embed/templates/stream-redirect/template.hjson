{
	templateId: redirect
	category: Special
	model: Stream
	containedBy: ["top", "folder", "article"]
	label: Redirect
	description: Forwards requests to another web address
	icon: forward
	schema: {
		type: object
		properties: {
			label: {type:"string", format:"text", maxLength:256}
			token: {type:"string", format:"text", maxLength:256}
			icon: {type:"string", format:"token", maxLength:64}
			summary: {type:"string", format:"html", maxLength:2048}
			data: {type: "object", properties: {
				url: {type: "string", format:"url"}
			}}
		}
	}
	states: {
		default: {
			label: Default
			description: Default state for Redirects
		}
		published: {
			label: Published
			description: The redirect is published and active
		}
	}

	roles: {
		viewer:{
			label: Viewer
			description: Can view this redirect but cannot make changes
		}
		editor:{
			label: Editor
			description: Editors can make changes to this stream
		}
	}
	actions: {
		create: {
			roles:["author", "editor"]
			steps:[
				{do:"set-data", values:{"label": "New Redirect"}}
				{do:"save"}
				{do:"forward-to", url:"/{{.StreamID}}/edit"}
			]
		}

		view: {
			stateRoles: {
				"published": ["anonymous"]
			}
			roles: ["author", "editor"]
			steps:[
				// "redirect-to" detects the off-origin target on its own and hands the navigation
				// to htmx when htmx is asking, so this works whether the visitor arrived through a
				// plain <a href> or through the sidebar's hx-get.  See build/navigation.go.
				{do:"redirect-to", url:"{{.Data `url`}}"}
			]
		}

		edit: {
			roles: ["author", "editor"]
			steps:[
				{do:"view-html"}
			]
		}
		edit-form: {
			roles: ["author", "editor"]
			steps:[
					{
						do:edit
						form: {
							type: layout-vertical
							children: [
								{type: "text", label: "Target URL", path: "data.url", description:"Full URL that visitors will be forwarded to (e.g. https://example.com/page-here)"}
								{type: "text", label: "Label", path: "label", description:"Displays in website navigation"}
								{type: "text", label: "Token/Slug", path: "token", description:"Unique identifier for the redirect", options:{autocomplete:"off", validator:"/.validate/streamToken?streamId={{.StreamID}}"}}
								{type: "select", path:"icon", label:"Icon", options:{provider:"folder-icons"}}
								{type: "textarea", label: "Summary", path: "summary", description:"Displays in website navigation", options:{rows:4}}
							]
						}
						options:[
							id:edit-form
							submit-button:hide
							cancel-button:hide
							endpoint:/{{.StreamID}}/edit-form
						]
					},
					{do:"save-and-publish", comment: "Updated Redirect"}
					{do:"refresh-page"}
					{do:"inline-save-button", form:"edit-form"}
				]
		}
		delete: {
			roles: ["author", "editor"]
			steps: [
				{do:"delete", title:"Delete this Redirect?", message:"This will permanently delete this content item from your website."}
				{do:"forward-to", url:"/admin/navigation"}
			]
		}
		
		sharing: {
			roles: ["author", "editor"]
			steps: [
				{do:"as-modal", steps: [
					{do:"set-simple-sharing", role: "viewer", title:"Who Can See This Folder?", message: "Select who can view this folder."}
					{do:"save", message: "Sharing updated by {{.Author}}"}
				]}
			]
		}
	}
}