{
	themeId: default
	extends:["global"]
	isVisible:true
	category: General
	label: Emissary Default
	description: Clean, general purpose theme for content-focused websites.
	rank: 0
	schema: {
		type: "object",
		properties: {
			iconId: {type:"string", format:"objectId"}
			iconUrl: {type:"string", format:"url"}
			label: {type:"string", maxLength:100, required: true}
			description: {type:"string", maxLength:100}
			themeId: {type:"string", maxLength: 100}
			registrationId: {type:"string", maxLength: 100}
		}
	}
	form: {
		type: layout-vertical
		children: [
			{type: "text", label: "Website Name", path: "label", description: "Title of this website and domain."}
			{type: "upload", label: "Icon", path: "iconUrl", description: "Icon for this website. Must be square. Often cropped to be a circle.", options:{accept:"image/*", delete:"/admin/domain/delete-icon"}, rules:{types:["webp"]}}
			{type: "upload", label: "Image", path: "imageUrl", description: "Image to display on signin pages and emails. Roughly 16:9 works best.", options:{accept:"image/*", delete:"/admin/domain/delete-image"}, rules:{types:["webp"]}}
			{type: "textarea", label: "Description", path: "description", options:{rows:5}}
		]
	}
	bundles: {
		stylesheet: {
			content-type:"text/css"
		}
	}
	startupTasks: [
		{label:"Website Name and Logo", description:"Set some basic info about this domain.", href:"/admin/domain/index", value:"/admin/domain"}
		{label:"Add Default Content", description:"Sample content pages help you understand how Emissary works.", href:"/startup/content", value:"/startup/content"}
		{label:"Blocklist Rules", description:"Create rules to filter content from the Internet.", href:"/admin/rules", value:"/admin/rules"}
		{label:"Registration Form (Optional)", description:"Enable users to register on this website.", href:"/admin/domain/signup", value:"/admin/domain/signup"}
		{label:"Configure Groups (Optional)", description:"Set up user groups to manage access and permissions.", href:"/admin/groups", value:"/admin/groups"}
	]
	startupStreams: [
		{templateId:"article-editorjs", token:"home", label:"Welcome!", rank:1}
		{templateId:"article-markdown", token:"join-the-team", label:"Join the Team", rank:3}
		// {templateId:"article-markdown", token:"about", label:"About Minimus", rank:2}
	]
	startupGroups:[
		{label:"Publishers"}
		{label:"Subscribers"}
	]
	defaultFolders: [
		{label:"Personal"}
		{label:"News"}
		{label:"Work-Related"}
	]
}
