{
	templateId: admin-startup
	templateRole: admin
	category: Admin
	model: Domain
	extends: ["admin-common"]
	containedBy:["admin"]
	label: "Startup"
	description: "Startup Wizard for new domains. (Site Admins Only)"
	schema: {
		type: "object"
		properties: {
			themeId: {type:"string", maxLength:128}
		}
	}
	actions: {
		page: {
			roles:["owner"]
			steps:[
				{do:"set-header", name:"Cache-Control", value:"no-store"}
				{do:"view-html"}
			]
		}
				
		choose-theme: {
			roles:["owner"]
			steps:[
				{do:"as-modal", steps:[
					{do:"view-html"}
					{do:"set-data", from-url:["themeId"]}
					{do:"save"}
				]}
			]
		}

		content: {
			roles:["owner"]
			steps:[
				{do:"as-modal", steps:[
					{do:"view-html"}
					{do:"startup-create-streams"}
					{do:"startup-save-task", value:"/startup/content"}					
				]}
				{do:"refresh-page"}
			]
		}

		complete: {
			roles:["owner"]
			steps:[
				{do:"startup-complete"}
				{do:"forward-to", url:"/@me"}
			]
		}				
	}
}
