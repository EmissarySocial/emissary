{
	templateId: admin-startup
	templateRole: admin
	category: Admin
	model: Domain
	extends: ["admin-common"]
	containedBy:["admin"]
	label: "Startup"
	description: "Startup Wizard for new domains. (Site Admins Only)"
	actions: {
		page: {
			roles:["owner"]
			steps:[
				{do:"set-header", name:"Cache-Control", value:"no-store"}
				{do:"view-html"}
			]
		}
				
		// The theme's own settings form, as admin-domain's index draws it, in a modal over the checklist
		domain: {
			roles:["owner"]
			steps:[
				{do:"as-modal", steps:[
					{do:"view-html"}
					{do:"edit"}
					{do:"upload-attachments", fieldname:"iconUrl", attachment-path:"iconId", category:"Icon", maximum:1, accept-type:"image/*", rules:{types:["webp"]}}
					{do:"upload-attachments", fieldname:"imageUrl", attachment-path:"imageId", category:"Image", maximum:1, accept-type:"image/*", rules:{types:["webp"]}}
					{do:"save"}
					{do:"startup-save-task", value:"/admin/domain"}
				]}
				{do:"refresh-page"}
			]
		}

		content: {
			roles:["owner"]
			steps:[
				{do:"as-modal", steps:[
					{do:"view-html"}
					{do:"startup-create-streams"}
					{do:"startup-save-task", value:"/startup/content"}					
				]}
				{do:"refresh-page"}
			]
		}

		groups: {
			roles:["owner"]
			steps:[
				{do:"as-modal", steps:[
					{do:"view-html"}
					{do:"startup-create-groups"}
					{do:"startup-save-task", value:"/admin/groups"}
				]}
				{do:"refresh-page"}
			]
		}

		complete: {
			roles:["owner"]
			steps:[
				{do:"startup-complete"}
				{do:"forward-to", url:"/@me"}
			]
		}				
	}
}
