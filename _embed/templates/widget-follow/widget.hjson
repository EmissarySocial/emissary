{
	widgetId:"follow"
	label:"Follow Button"
	description:"Adds a button that opens the 'Follow' window for a person on this server"
	schema:{
		type:"object"
		properties:{
			// Neither field is Required.  A widget that is dropped onto the page and saved
			// before it is filled in must still save -- widget.html handles the empty case
			// by explaining itself to the author instead of rendering a broken button.
			label:{type:"string", format:"text", maxLength:64, default:""}

			// The "username" format admits only [A-Za-z0-9_], which is what makes it safe
			// to interpolate this value straight into the button's hx-get URL.  Do not
			// relax it to "text" without escaping at the render site.  MaxLength matches
			// model.User's own username field.
			username:{type:"string", format:"username", maxLength:32, default:""}

			// Bounds the value to characters that can only ever BE class names: letters (any
			// script), digits, "_", "-", and whitespace to separate them.  html/template would
			// escape a stray quote here anyway, so this is not the thing standing between an
			// author and an attribute breakout -- it is what keeps a styling hook from becoming
			// a place to put arbitrary text.  Note "\\s" and "\\p": hjson unescapes the doubled
			// backslash, so the regex the schema compiles is ^[\s\p{L}\p{N}_-]*$.
			class:{type:"string", format:"regex=^[\\s\\p{L}\\p{N}_-]*$", maxLength:128, default:""}
		}
	}
	form:{
		type:"layout-vertical"
		label:"Edit Follow Button"
		description:"Choose the person that visitors will follow, and the label on the button."
		children:[
			// The validator checks the name against the server as it is typed.  Its URL carries no
			// parameters, which matters here: a widget.hjson form is NOT rendered as a template, so
			// a "{{.Something}}" in this string would reach the browser verbatim.
			{type:"text", path:"username", label:"Username", description:"The username of a person on this server. Letters, numbers, and underscores only.", options:{placeholder:"username", autocomplete:"off", validator:"/.validate/user/exists"}}
			{type:"text", path:"label", label:"Button Label", description:"Defaults to 'Follow' when empty.", options:{placeholder:"Follow"}}
			{type:"text", path:"class", label:"CSS Class", description:"Optional. Applied to a wrapper around the button, so your stylesheet can position it.", options:{autocomplete:"off"}}
		]
	}
}
